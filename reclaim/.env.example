# Copy to .env.local for local development. Never commit real values.

# --- Live AI (optional) ---------------------------------------------------
# Leave RECLAIM_AI_ENABLED=false (or the key empty) to run the reviewed,
# deterministic support flow only. The key is read on the server only.
RECLAIM_AI_ENABLED=false
ANTHROPIC_API_KEY=
# Model used for the short personalised response.
RECLAIM_AI_MODEL=claude-opus-5-5
# Hard timeout for the AI call in milliseconds. On timeout the reviewed
# fallback is shown instead.
RECLAIM_AI_TIMEOUT_MS=12000

# --- Telegram community (optional) ----------------------------------------
# Public invite link to the existing Reclaim Telegram community.
# Leave empty to hide the link entirely. Must start with https://t.me/
NEXT_PUBLIC_RECLAIM_TELEGRAM_URL=

# --- Rate limiting -----------------------------------------------------------
# Plan requests allowed per client per window (in-memory, per server instance).
RECLAIM_RATE_LIMIT_MAX=8
RECLAIM_RATE_LIMIT_WINDOW_MS=600000
